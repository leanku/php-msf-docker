# 镜像名称与标签（供 build.sh 使用）
IMAGE_NAME=php-msf
IMAGE_TAG=alpine-php8.5
REGISTRY_IMAGE=
PLATFORM=linux/amd64
BUILD_TARGET=runtime

# Redis：默认单实例；集群各节点均设置为 true，并确保节点间端口可互通。
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_PORT=6379
REDIS_CLUSTER_BUS_PORT=16379
REDIS_CLUSTER_ANNOUNCE_IP=
REDIS_CLUSTER_ANNOUNCE_PORT=6379
REDIS_CLUSTER_ANNOUNCE_BUS_PORT=16379
REDIS_PASSWORD=
